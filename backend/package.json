{
  "name": "app",
  "version": "1.0.50",
  "scripts": {
    "dev:watch": "NODE_ENV=development bun run --watch src/index.ts",
    "dev:db": "docker compose -f src/db/docker-compose.yaml --env-file .env up",
    "dev": "concurrently -k -s first -c auto -n DB,WATCH \"bun run dev:db\" \"bun run dev:watch\"",
    "studio": "drizzle-kit studio",
    "migration:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "migration:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "better-auth": "^1.3.7",
    "dotenv": "^17.2.1",
    "dotenv-expand": "^12.0.2",
    "drizzle-orm": "^0.44.4",
    "elysia": "latest",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/pg": "^8.15.5",
    "bun-types": "latest",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.51.0"
  },
  "type": "module",
  "module": "src/index.js"
}
